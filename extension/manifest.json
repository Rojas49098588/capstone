{
  "manifest_version": 3,
  "name": "Capstone Pet",
  "version": "0.3.0",
  "description": "Your Studium project pets follow you around the web. Click the icon to open Studium.",
  "permissions": ["storage", "tabs", "contextMenus", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Studium once to meet your pets"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/pets/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/logic.js", "content/menu.js", "content/bridge.js", "content/pet.js"],
      "run_at": "document_idle"
    }
  ]
}
