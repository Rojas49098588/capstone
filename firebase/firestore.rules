rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own document and everything under it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A shared project. Membership changes are not allowed here. Its id is "<owner uid>_<project id>",
    // so two accounts' projects never collide and nobody can take an id another account will need.
    match /projects/{pid} {
      allow create: if request.auth != null
        && pid.matches(request.auth.uid + '_.*')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow read, delete: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.owner == resource.data.owner;
    }

    // Requirements, tasks, events: members of the parent project only.
    match /projects/{pid}/{sub}/{id} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/projects/$(pid)).data.members;
    }
  }
}
