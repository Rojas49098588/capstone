{
  "name": "studium-desktop",
  "productName": "Studium",
  "version": "0.4.0",
  "description": "Studium and its project pets as a desktop app",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm --prefix ../web run build && electron .",
    "dev": "electron . --dev",
    "test": "vitest run",
    "test:e2e": "npm --prefix ../web run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.4"
  }
}
